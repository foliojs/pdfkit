{
  "name": "pdfkit",
  "description": "A PDF generation library for Node.js",
  "keywords": [
    "pdf",
    "pdf writer",
    "pdf generator",
    "graphics",
    "document",
    "vector"
  ],
  "version": "0.19.1",
  "homepage": "http://pdfkit.org/",
  "author": {
    "name": "Devon Govett",
    "email": "devongovett@gmail.com",
    "url": "http://badassjs.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foliojs/pdfkit.git"
  },
  "bugs": "https://github.com/foliojs/pdfkit/issues",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-external-helpers": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "blob-stream": "^0.1.3",
    "brace": "^0.11.1",
    "brfs": "~2.0.2",
    "browserify": "^17.0.1",
    "canvas": "^3.2.3",
    "codemirror": "~5.65.21",
    "eslint": "^10.4.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jest-diff": "^30.4.1",
    "jest-image-snapshot": "^6.5.2",
    "markdown": "~0.5.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "3.4.2",
    "pug": "^3.0.4",
    "rollup": "^4.61.1",
    "rollup-plugin-copy": "^3.5.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.6.0",
    "fontkit": "^2.0.4",
    "js-md5": "^0.8.3",
    "linebreak": "^1.1.0",
    "png-js": "^1.1.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rollup -c",
    "build-standalone": "browserify --standalone PDFDocument --ignore crypto js/pdfkit.js > js/pdfkit.standalone.js",
    "browserify-example": "browserify examples/browserify/browser.js > examples/browserify/bundle.js",
    "pdf-guide": "node docs/generate.js",
    "website": "node docs/generate_website.js",
    "publish-website": "node docs/publish_website.js",
    "docs": "npm run pdf-guide && npm run website && npm run browserify-example",
    "lint": "eslint {lib,tests,tools}/**/*.js",
    "prettier": "prettier --check lib tests docs tools",
    "format": "prettier --write lib tests docs tools",
    "test": "vitest --testTimeout 8000 run --exclude \"tests/tools/**\"",
    "test:package": "node tests/package-resolution.cjs",
    "test:tools": "vitest --testTimeout 8000 run tests/tools",
    "test:visual": "vitest --testTimeout 8000 run tests/visual",
    "test:unit": "vitest run tests/unit"
  },
  "exports": {
    ".": {
      "node": {
        "require": "./js/pdfkit.js"
      },
      "default": "./js/pdfkit.browser.mjs"
    },
    "./virtual-fs": {
      "default": "./js/virtual-fs.js"
    },
    "./standard-fonts/Courier": {
      "require": "./js/standard-fonts/Courier.cjs",
      "default": "./js/standard-fonts/Courier.mjs"
    },
    "./standard-fonts/CourierBold": {
      "require": "./js/standard-fonts/CourierBold.cjs",
      "default": "./js/standard-fonts/CourierBold.mjs"
    },
    "./standard-fonts/CourierBoldOblique": {
      "require": "./js/standard-fonts/CourierBoldOblique.cjs",
      "default": "./js/standard-fonts/CourierBoldOblique.mjs"
    },
    "./standard-fonts/CourierOblique": {
      "require": "./js/standard-fonts/CourierOblique.cjs",
      "default": "./js/standard-fonts/CourierOblique.mjs"
    },
    "./standard-fonts/Helvetica": {
      "require": "./js/standard-fonts/Helvetica.cjs",
      "default": "./js/standard-fonts/Helvetica.mjs"
    },
    "./standard-fonts/HelveticaBold": {
      "require": "./js/standard-fonts/HelveticaBold.cjs",
      "default": "./js/standard-fonts/HelveticaBold.mjs"
    },
    "./standard-fonts/HelveticaBoldOblique": {
      "require": "./js/standard-fonts/HelveticaBoldOblique.cjs",
      "default": "./js/standard-fonts/HelveticaBoldOblique.mjs"
    },
    "./standard-fonts/HelveticaOblique": {
      "require": "./js/standard-fonts/HelveticaOblique.cjs",
      "default": "./js/standard-fonts/HelveticaOblique.mjs"
    },
    "./standard-fonts/Symbol": {
      "require": "./js/standard-fonts/Symbol.cjs",
      "default": "./js/standard-fonts/Symbol.mjs"
    },
    "./standard-fonts/TimesBold": {
      "require": "./js/standard-fonts/TimesBold.cjs",
      "default": "./js/standard-fonts/TimesBold.mjs"
    },
    "./standard-fonts/TimesBoldItalic": {
      "require": "./js/standard-fonts/TimesBoldItalic.cjs",
      "default": "./js/standard-fonts/TimesBoldItalic.mjs"
    },
    "./standard-fonts/TimesItalic": {
      "require": "./js/standard-fonts/TimesItalic.cjs",
      "default": "./js/standard-fonts/TimesItalic.mjs"
    },
    "./standard-fonts/TimesRoman": {
      "require": "./js/standard-fonts/TimesRoman.cjs",
      "default": "./js/standard-fonts/TimesRoman.mjs"
    },
    "./standard-fonts/ZapfDingbats": {
      "require": "./js/standard-fonts/ZapfDingbats.cjs",
      "default": "./js/standard-fonts/ZapfDingbats.mjs"
    }
  },
  "imports": {
    "#standard-fonts/*": {
      "require": "./js/standard-fonts/*.cjs",
      "default": "./js/standard-fonts/*.mjs"
    }
  },
  "browserify": {
    "transform": [
      "brfs"
    ]
  },
  "engine": [
    "node >= v20.0.0"
  ],
  "packageManager": "yarn@4.16.0"
}
